# Copy to `.env` and fill in. `.env` is gitignored.
#
# Get both URLs from Supabase Studio -> Project Settings -> Database ->
# Connection String. Use the "Transaction" pooler URL (port 6543) for the
# ETL — it's optimized for short-lived connections.
#
# IMPORTANT: use the connection string that contains the database PASSWORD,
# not the project's anon/service_role JWT. The DB password is the only thing
# pg8000 needs; the service_role JWT is for the PostgREST/Realtime layer
# and not for direct Postgres connections.
#
# RLS gates access at the Postgres role level. Connecting as `postgres`
# (default for the connection string above) bypasses RLS just like
# `service_role` does. If you'd prefer to connect specifically as
# service_role, generate a role-specific password via the dashboard.

SOURCE_DB_URL=postgresql://postgres.<oltp-project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
TARGET_DB_URL=postgresql://postgres.<analytics-project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional knobs (defaults shown).
# BATCH_SIZE=1000
# MAX_BATCHES=0
# ETL_KEY=brawler_fact_load
