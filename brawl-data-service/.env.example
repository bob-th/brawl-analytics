PORT=4001
BRAWL_API_BASE_URL=https://api.brawlstars.com/v1
BRAWL_DATA_URL=http://localhost:4001/player/%232JCJG00/battles/
BRAWL_DEVELOPER_API_KEY=your-supercell-developer-jwt

# Supabase service-role credentials — required by the write pipeline
# (database.ts / persistNewBattles). Service role bypasses RLS and is the only
# role with access to the `private` schema. Never expose to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: max tags processed concurrently within one batch (default 10).
BATCH_CONCURRENCY=10
