# ============================================================================
# Shared environment template for Brawl Analytics.
# Copy to `.env` (same directory) and fill in real values. The real `.env` is
# gitignored. Consumed by backend, brawl-data-service, coordinator-service
# (local runs), and the CDK app.
# ============================================================================

# --- Supabase (all services) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AWS (coordinator-service local runs + CDK) ---
AWS_REGION=us-east-2

# --- backend ---
BACKEND_PORT=4000
DATA_SERVICE_URL=http://localhost:4001

# --- brawl-data-service ---
DATA_SERVICE_PORT=4001
BRAWL_API_BASE_URL=https://api.brawlstars.com/v1
BRAWL_DEVELOPER_API_KEY=
# Brawl key registered to the NAT egress IP; injected into the write-path Lambda.
LAMBDA_BS_DEV_KEY=

# --- coordinator-service ---
SQS_QUEUE_URL=

# --- CDK (LambdaStack imports the existing queue by ARN) ---
SQS_QUEUE_ARN=
